# Instagram Account Credentials
INSTAGRAM_USERNAME=your_instagram_handle
INSTAGRAM_PASSWORD=your_instagram_password

# 3rd-Party / Custom AI API Credentials (GPT 5.2 or any model)
AI_API_KEY=your_3rd_party_api_key_here
AI_BASE_URL=https://api.your-3rd-party-provider.com/v1
AI_MODEL=gpt-5.2

# Bot Configuration
CHECK_INTERVAL_SECONDS=30
SYSTEM_PROMPT="You are an AI assistant replying on behalf of the user who is currently offline/busy. Be friendly, concise, helpful, and natural."

# Server Port (Set automatically by Koyeb / Render)
PORT=8000
